<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg129230.view.BattleController">
   <children>
      <Label fx:id="enemyLabel" text="Label">
         <graphic>
            <ProgressBar fx:id="enemyHealthBar" prefWidth="200.0" progress="0.0" />
         </graphic></Label>
      <Label fx:id="heroLabel" text="Label">
         <graphic>
            <ProgressBar fx:id="heroHealthBar" prefWidth="200.0" progress="0.0" />
         </graphic></Label>
      <HBox prefHeight="100.0" prefWidth="200.0" styleClass="actions">
         <children>
            <Button fx:id="attackButton" mnemonicParsing="false" onAction="#onAttack" text="Attack" />
            <Button fx:id="defendButton" mnemonicParsing="false" onAction="#onDefend" text="Defense" />
            <Button fx:id="dodgeButton" mnemonicParsing="false" onAction="#onDodge" text="Dodge" />
            <Button fx:id="potionButton" mnemonicParsing="false" onAction="#onPotion" text="Potion" />
            <Button fx:id="continueButton" mnemonicParsing="false" onAction="#onContinue" text="Continue" />
         </children>
      </HBox>
      <TextArea fx:id="logArea" editable="false" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
